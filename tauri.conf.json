{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frame Studio",
  "version": "1.0.0",
  "identifier": "com.framestudio.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Frame Studio",
        "width": 1380,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 680,
        "backgroundColor": "#1b1b1b"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: data:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis", "msi"],
    "shortDescription": "Professional batch image framing studio",
    "category": "GraphicsAndDesign"
  }
}
